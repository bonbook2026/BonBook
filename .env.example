# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Optional local Telegram simulator (never enabled in production).
# `npm run dev:local` enables this automatically on loopback only.
ENABLE_LOCAL_TELEGRAM_LOGIN=false

# Database
DATABASE_URL="file:./bonbook.db"

# BonCard Payment Provider
BONCARD_API_URL=https://api.boncard.ir
BONCARD_API_KEY=your_boncard_api_key_here
BONCARD_SECRET_KEY=your_boncard_secret_here
BONCARD_CALLBACK_URL=https://yourdomain.com/api/payments/callback

# Email Service
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@bonbook.ir

# Book Pricing
BOOK_PRICE_TOMAN=1500000
MAX_BOOKS_PER_ORDER=50

# Frontend URL
FRONTEND_URL=http://localhost:5173

# https://github.com/bonbook2026/
