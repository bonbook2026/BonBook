generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  telegramId       String   @unique @map("telegram_id")
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  email            String?
  role             String   @default("READER")
  telegramUsername String?  @map("telegram_username")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  orders          Order[]
  identities      AuthIdentity[]
  readingProgress ReadingProgress[]

  @@map("users")
}

model Book {
  id         Int      @id @default(autoincrement())
  title      String
  fileUrl    String?  @map("file_url")
  priceUsd   Float?   @map("price_usd")
  priceToman Int      @default(1500000) @map("price_toman")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("books")
}

model Order {
  id           Int       @id @default(autoincrement())
  orderNumber  String    @unique @map("order_number")
  userId       Int       @map("user_id")
  totalBooks   Int       @map("total_books")
  // Legacy values remain for existing orders; fixed-price orders leave them null.
  totalUsd     Float?    @map("total_usd")
  exchangeRate Float?    @map("exchange_rate")
  totalIrr     Float     @map("total_irr")
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now()) @map("created_at")
  paidAt       DateTime? @map("paid_at")

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  deliveries Delivery[]

  @@map("orders")
}

model OrderItem {
  id         Int    @id @default(autoincrement())
  orderId    Int    @map("order_id")
  bookId     Int?   @map("book_id")
  bookTitle  String @map("book_title")
  priceUsd   Float? @map("price_usd")
  priceToman Int?   @map("price_toman")

  order Order @relation(fields: [orderId], references: [id])
  book  Book? @relation(fields: [bookId], references: [id])

  @@map("order_items")
}

model Payment {
  id         Int       @id @default(autoincrement())
  orderId    Int       @map("order_id")
  provider   String
  paymentId  String?   @map("payment_id")
  amountIrr  Float     @map("amount_irr")
  status     String    @default("PENDING")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  rawData    String?   @map("raw_data")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Delivery {
  id           Int       @id @default(autoincrement())
  orderId      Int       @map("order_id")
  email        String
  status       String    @default("PENDING")
  sentAt       DateTime? @map("sent_at")
  errorMessage String?   @map("error_message")

  order Order @relation(fields: [orderId], references: [id])

  @@map("deliveries")
}

model AuthIdentity {
  id            Int     @id @default(autoincrement())
  userId        Int     @map("user_id")
  provider      String
  subject       String
  verifiedEmail String? @map("verified_email")
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@map("auth_identities")
}

model SiteSetting {
  key   String @id
  value String

  @@map("site_settings")
}

model AdminGrant {
  id            Int      @id @default(autoincrement())
  kind          String
  identifier    String
  claimedUserId Int?     @map("claimed_user_id")
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([kind, identifier])
  @@map("admin_grants")
}

model OAuthAttempt {
  stateHash String    @id @map("state_hash")
  verifier  String
  nonce     String
  nextPath  String    @map("next_path")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@map("oauth_attempts")
}

model MediaAsset {
  id          String        @id
  filename    String
  mimeType    String        @map("mime_type")
  kind        String
  size        Int
  createdById Int           @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  covers      LibraryBook[] @relation("LibraryCover")
  audioPages  LibraryPage[] @relation("PageAudio")
  pageImages  LibraryPage[] @relation("PageImage")
  sourcePages LibraryPage[] @relation("PageSource")
  imports     BookImport[]
  alignments  AudioAlignment[]

  @@map("media_assets")
}

model LibraryBook {
  id              Int               @id @default(autoincrement())
  title           String
  author          String            @default("")
  description     String            @default("")
  category        String            @default("عمومی")
  categoryId      Int?              @map("category_id")
  categoryNode    BookCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            String            @default("")
  catalogText     String            @default("") @map("catalog_text")
  language        String            @default("fa-IR")
  coverTone       String            @default("sand") @map("cover_tone")
  coverAssetId    String?           @map("cover_asset_id")
  coverLayout     String            @default("SINGLE") @map("cover_layout")
  coverFrontSide  String            @default("LEFT") @map("cover_front_side")
  coverSpineStart Float             @default(48) @map("cover_spine_start")
  coverSpineEnd   Float             @default(52) @map("cover_spine_end")
  cover           MediaAsset?       @relation("LibraryCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  status          String            @default("DRAFT")
  deletedAt       DateTime?         @map("deleted_at")
  isSample        Boolean           @default(false) @map("is_sample")
  createdById     Int?              @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  pages           LibraryPage[]
  progress        ReadingProgress[]
  imports         BookImport[]
  contents        BookContents[]
  audioBatches    AudioBatch[]

  @@index([status, categoryId])
  @@map("library_books")
}

model BookContents {
  id         Int         @id @default(autoincrement())
  bookId     Int         @map("book_id")
  book       LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title      String
  pageNumber Int         @map("page_number")
  level      Int         @default(0)
  position   Int         @default(0)

  @@index([bookId, position])
  @@map("book_contents")
}

model LibraryPage {
  id               Int         @id @default(autoincrement())
  bookId           Int         @map("book_id")
  number           Int
  heading          String      @default("")
  content          String
  keywords         String      @default("")
  searchText       String      @default("") @map("search_text")
  audioAssetId     String?     @map("audio_asset_id")
  audioCues        String      @default("[]") @map("audio_cues")
  audioCueMode     String      @default("NONE") @map("audio_cue_mode")
  imageAssetId     String?     @map("image_asset_id")
  image            MediaAsset? @relation("PageImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  visualMode       String      @default("AUTO") @map("visual_mode")
  audio            MediaAsset? @relation("PageAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)
  sourceAssetId    String?     @map("source_asset_id")
  source           MediaAsset? @relation("PageSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  sourcePageNumber Int?        @map("source_page_number")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  book             LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  alignments       AudioAlignment[]

  @@unique([bookId, number])
  @@map("library_pages")
}

model AudioBatch {
  id              String           @id
  bookId          Int              @map("book_id")
  book            LibraryBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  status          String           @default("UPLOADING")
  autoAlign       Boolean          @default(true) @map("auto_align")
  replaceExisting Boolean          @default(false) @map("replace_existing")
  createdById     Int              @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  items           AudioBatchItem[]

  @@index([bookId, createdAt])
  @@map("audio_batches")
}

model AudioBatchItem {
  id              String     @id
  batchId         String     @map("batch_id")
  batch           AudioBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  pageNumber      Int        @map("page_number")
  filename        String
  size            Int
  expectedAssetId String?    @map("expected_asset_id")
  assetId         String?    @map("asset_id")
  status          String     @default("WAITING")
  error           String?

  @@unique([batchId, pageNumber])
  @@map("audio_batch_items")
}

model AudioAlignment {
  id              String      @id
  pageId          Int         @map("page_id")
  page            LibraryPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  audioAssetId    String      @map("audio_asset_id")
  audio           MediaAsset  @relation(fields: [audioAssetId], references: [id])
  contentHash     String      @map("content_hash")
  previousCues    String      @default("[]") @map("previous_cues")
  status          String      @default("QUEUED")
  progress        Float       @default(0)
  attempts        Int         @default(0)
  coverage        Float       @default(0)
  lineCoverage    Float       @default(0) @map("line_coverage")
  duration        Float       @default(0)
  words           String      @default("[]")
  cues            String      @default("[]")
  candidates      String      @default("[]")
  warning         String      @default("")
  error           String?
  model           String      @default("faster-whisper-small")
  createdById     Int         @map("created_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([pageId, createdAt])
  @@map("audio_alignments")
}

model BookCategory {
  id       Int            @id @default(autoincrement())
  name     String
  key      String         @unique
  parentId Int?           @map("parent_id")
  parent   BookCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children BookCategory[] @relation("CategoryTree")
  books    LibraryBook[]

  @@map("book_categories")
}

model BookImport {
  id             String         @id
  bookId         Int            @map("book_id")
  book           LibraryBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sourceAssetId  String         @map("source_asset_id")
  source         MediaAsset     @relation(fields: [sourceAssetId], references: [id])
  filename       String
  sources        String         @default("[]")
  format         String
  mode           String         @default("auto")
  status         String         @default("QUEUED")
  totalPages     Int            @default(0) @map("total_pages")
  completedPages Int            @default(0) @map("completed_pages")
  attempts       Int            @default(0)
  warnings       String         @default("")
  error          String?
  createdById    Int            @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  pages          ImportedPage[]

  @@index([status, createdAt])
  @@map("book_imports")
}

model ImportedPage {
  id               Int        @id @default(autoincrement())
  importId         String     @map("import_id")
  import           BookImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  number           Int
  heading          String     @default("")
  content          String
  sourceAssetId    String?    @map("source_asset_id")
  sourcePageNumber Int?       @map("source_page_number")

  @@unique([importId, number])
  @@map("imported_pages")
}

model ReadingProgress {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  bookId     Int         @map("book_id")
  pageNumber Int         @map("page_number")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("reading_progress")
}
