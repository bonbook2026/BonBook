{
  "name": "bonbook-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo --base=/BonBook/",
    "build:preproduction": "tsc -b && vite build --mode preproduction --base=/ --outDir dist-preproduction",
    "test:demo": "node --test tests/demo.test.cjs tests/covers.test.cjs tests/narration.test.cjs tests/audioFiles.test.cjs tests/bookAudioQueue.test.cjs tests/library.test.cjs tests/readingProgress.test.cjs tests/pageCanvas.test.cjs tests/readingJourney.test.cjs tests/journeyPlayback.test.cjs tests/lunarLight.test.cjs",
    "preview:demo": "vite preview --mode demo --base=/BonBook/ --host 127.0.0.1",
    "preview": "vite preview",
    "preview:journey": "vite --config vite.journey.config.ts --host 127.0.0.1 --port 3152 --strictPort",
    "test:journey": "node --test tests/readingJourney.test.cjs"
  },
  "dependencies": {
    "@twa-dev/sdk": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
